{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supportiq-worker",
  "main": "dist/_worker.js",
  "compatibility_date": "2024-09-02",
  "compatibility_flags": ["nodejs_compat"],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "supportiq-db",
      "database_id": "372b1c5c-9662-468f-a92f-f38420b24c15"
    }
  ],

  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "supportiq-docs"
    }
  ],

  "vars": {
    "ENVIRONMENT": "production",
    "APP_URL": "https://supportiq-worker.hamzaka549.workers.dev",
    "TENANT_SUBDOMAIN_ENABLED": "false"
  }
}
